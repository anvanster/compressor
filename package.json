{
  "name": "@astudioplus/compressor",
  "version": "0.3.0",
  "description": "Reduce token usage in AI coding agents (Claude Code, Copilot, Cursor) with instruction packs and tool-output compression hooks \u2014 savings you can measure.",
  "type": "module",
  "author": "Andrey Vasilevsky <anvanster@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/anvanster/compressor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvanster/compressor.git"
  },
  "bugs": {
    "url": "https://github.com/anvanster/compressor/issues"
  },
  "keywords": [
    "token-optimization",
    "prompt-compression",
    "context-compression",
    "ai-coding-agents",
    "claude-code",
    "github-copilot",
    "cursor",
    "agents-md",
    "llm",
    "anthropic",
    "developer-tools",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "bin": {
    "compressor": "dist/cli/index.js",
    "compressor-hook": "dist/hook.js",
    "compressor-copilot-hook": "dist/copilot-hook.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine/index.js",
    "./tokens": "./dist/tokens/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle:hook && npm run bundle:copilot-hook && npm run bundle:opencode-plugin",
    "bundle:hook": "esbuild src/hook-entry.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/hook.js",
    "bundle:copilot-hook": "esbuild src/copilot-hook-entry.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/copilot-hook.js",
    "bundle:opencode-plugin": "esbuild src/opencode-plugin-entry.ts --bundle --platform=node --format=esm --outfile=dist/opencode-plugin.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
