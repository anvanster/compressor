# Local settings, not shared: steering artifacts the extension writes into
# whatever repo it is enabled in, including this one. CI workflows stay
# trackable so they can be added without loosening this.
.github/*
!.github/workflows/
node_modules/
dist/
.smelt/
internal/
bench/results/
*.log
config.local
.repro-scratch/
*.tgz

# compressor's own install artifacts (dogfooding) — machine-specific hook paths
# and generated output styles; never commit to the public repo
.claude/settings.local.json
.claude/settings.json
.claude/output-styles/
