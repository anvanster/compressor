# Local, not shared: the Copilot steering artifacts compressor installs into
# whatever repo it is enabled in, including this one (dogfooding). Named
# exactly, not `.github/*` — a blanket ignore would silently swallow workflows,
# dependabot.yml, ISSUE_TEMPLATE/ and friends with no error to notice.
.github/copilot-instructions.md
.github/hooks/
node_modules/
dist/
.smelt/
internal/
bench/results/
*.log
config.local
.repro-scratch/
*.tgz

# compressor's own install artifacts (dogfooding) — machine-specific hook paths
# and generated output styles; never commit to the public repo
.claude/settings.local.json
.claude/settings.json
.claude/output-styles/
