+
+/**
+ * Authorize a payment, queueing a retry with exponential backoff when the
+ * gateway reports a transient failure. Hard declines are never retried.
+ */
+export function chargeWithRetry(queue, intent, attempt = 0) {
+  const result = authorizePayment(intent);
+  if (result.status !== 'transient_failure') {
+    return result;
+  }
+  const scheduled = scheduleRetry(
+    queue,
+    { id: intent.id, intent },
+    computeBackoff(attempt),
+    attempt + 1,
+  );
+  if (!scheduled) {
+    return { status: 'failed', code: result.code };
+  }
+  return { status: 'retry_scheduled', code: result.code, nextAttempt: attempt + 1 };
+}
