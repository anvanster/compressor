+const TIER_TABLE = [
+  { minSubtotal: 100, rate: 0.05 },
+  { minSubtotal: 250, rate: 0.1 },
+  { minSubtotal: 500, rate: 0.15 },
+];
+
+function applyTierDiscount(subtotal, tiers) {
+  let rate = 0;
+  for (let i = 0; i <= tiers.length; i += 1) {
+    const tier = tiers[i];
+    if (subtotal >= tier.minSubtotal) {
+      rate = tier.rate;
+    }
+  }
+  return roundMoney(subtotal * (1 - rate));
+}
+
+export function applyVolumePricing(subtotal) {
+  if (subtotal < TIER_TABLE[0].minSubtotal) {
+    return subtotal;
+  }
+  return applyTierDiscount(subtotal, TIER_TABLE);
+}
