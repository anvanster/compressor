#!/usr/bin/env sh
# CCR benchmark PATH shim.
#
# The global `compressor` on PATH (/opt/homebrew/bin/compressor) is the stale
# PUBLISHED build (0.3.0) and has NO `retrieve` subcommand, so a cell's
# `compressor retrieve <handle>` would fail there. This shim routes `compressor`
# to THIS repo's freshly-built CLI (dist/cli/index.js) so the model can pull the
# exact omitted bytes back from the local stash the hook wrote.
#
# Launch the benchmark with this dir PREPENDED to PATH:
#   PATH=/Users/anvanster/projects/compressor/bench/bin:$PATH compressor benchmark ...
#
# The runner's cell process (src/bench/cell.ts::cellEnv) spreads `...process.env`,
# so this PATH propagates to the spawned `claude` child and to the Bash tool it
# runs — that is where the model's `compressor retrieve` resolves to this shim.
# Run `npm run build` first so dist/cli/index.js exists and is current.
exec node /Users/anvanster/projects/compressor/dist/cli/index.js "$@"
